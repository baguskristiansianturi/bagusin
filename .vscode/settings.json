{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "**/.git": true
  },
  "search.exclude": {
    "**/assets/images/**": true
  },
  "html.format.indentInnerHtml": false,
  "css.validate": true,
  "javascript.validate.enable": true
}
